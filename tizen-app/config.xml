<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tizen Web Application manifest.

  This is a SEPARATE project from the Compose Multiplatform / Kotlin-Wasm
  build (see ../shared). Nothing here is Kotlin, and this is not a "fake
  native Tizen target" - it is the standard W3C-widget-format manifest every
  Tizen Web App needs, wrapping the *output* of `shared`'s wasmJs target
  (see README-TIZEN.md for exactly how that output gets in here).

  required_version="9.0" is deliberate, not a placeholder: Compose
  Multiplatform's web target needs a browser with WebAssembly GC support,
  which shipped in Chromium 119 (chromium.googlesource.com /
  developer.chrome.com/blog/wasmgc). Per Samsung's own Web Engine
  Specifications page, Tizen 8.0 (2024 TVs) ships Chromium M108 - below 119,
  so those TVs cannot run this app at all - while Tizen 9.0 (2025 TVs) ships
  Chromium M120. Setting required_version="9.0" tells Tizen Studio/the TV
  itself to refuse to install this app on anything older, rather than
  installing it somewhere it can only fail on. See README.md ->
  "Tizen/Samsung TV compatibility" for the full writeup and sources.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://example.com/DummyTvApp"
        version="1.0.0"
        viewmodes="maximized">

    <!--
      package/id: the 10-character prefix (here, a placeholder) must match
      the signing certificate's author ID, generated by Tizen Studio's
      Certificate Manager (Tools > Certificate Manager > create a Tizen/
      Samsung certificate profile). Tizen Studio rewrites this value to match
      your profile automatically when you package the app, but the
      placeholder is left obviously fake here so this file cannot be
      mistaken for something already correctly signed.
    -->
    <tizen:application id="XXXXXXXXXX.DummyTvApp"
                        package="XXXXXXXXXX"
                        required_version="9.0"/>

    <tizen:profile name="tv"/>

    <icon src="icon.png"/>
    <name>Dummy TV App</name>
    <content src="index.html"/>

    <!--
      screen-orientation/context-menu/background-support/encryption/
      install-location below are the standard tizen:setting attributes that
      appear in Tizen's own Web Application samples and Tizen Studio's
      generated config.xml. If you open this project in Tizen Studio, its
      config.xml GUI editor's "Setting" tab is the authoritative place to
      review/change these (and to add anything else, e.g. hardware-key
      handling flags, that this file does not set explicitly).
    -->
    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"/>

    <!--
      No tizen:privilege entries are needed for input: per Samsung's Remote
      Control developer docs, the arrow keys, Enter, and Back are delivered
      as ordinary DOM keydown events without calling
      tizen.tvinputdevice.registerKey() first (that API/privilege is only
      needed for extra keys this app does not use, like the colored
      A/B/C/D buttons or media transport keys).
    -->

</widget>
